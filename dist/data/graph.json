,"tier":6},{"id":"DXY","label":"Dollar","series_id":"DXY","tier":7},{"id":"MBS_YIELD","label":"MBS yield","series_id":"MBS_CC","tier":1},{"id":"MBS_PRICE","label":"MBS price","series_id":"MBS_PRICE","tier":1},{"id":"MBS_SPREAD","label":"MBS spread","series_id":"MBS_SPREAD","tier":1},{"id":"MORTGAGE_30Y","label":"30Y mortgage rate","series_id":"MORT30Y","tier":1},{"id":"HOUSING_DEMAND","label":"Housing demand","series_id":"EHS","tier":8},{"id":"MTG_APPS","label":"Mortgage applications","series_id":null,"tier":8}],"edges":[{"src":"CORE_CPI","dst":"INFL_EXPECT","sign":1,"weight":0.8,"lag_days":0,"confidence":0.9,"rationale":"Realised core inflation is the largest single input to forward inflation pricing."},{"src":"HEADLINE_CPI","dst":"INFL_EXPECT","sign":1,"weight":0.45,"lag_days":0,"confidence":0.6,"rationale":"Headline feeds expectations but is discounted for energy noise."},{"src":"PPI","dst":"CORE_CPI","sign":1,"weight":0.35,"lag_days":30,"confidence":0.6,"rationale":"Producer prices lead consumer prices with a lag."},{"src":"SHELTER","dst":"CORE_CPI","sign":1,"weight":0.6,"lag_days":0,"confidence":0.9,"rationale":"Shelter is roughly a third of core CPI."},{"src":"AHE","dst":"INFL_EXPECT","sign":1,"weight":0.5,"lag_days":0,"confidence":0.6,"rationale":"Wages drive services inflation."},{"src":"OIL","dst":"INFL_EXPECT","sign":1,"weight":0.45,"lag_days":0,"confidence":0.6,"rationale":"WTI is the US refinery input, so it drives the gasoline line in headline CPI within two to four weeks."},{"src":"BRENT","dst":"INFL_EXPECT","sign":1,"weight":0.55,"lag_days":0,"confidence":0.6,"rationale":"Brent prices roughly two thirds of the world\u2019s traded crude, so it is the better read on GLOBAL inflation. Foreign inflation feeds foreign policy rates, which feeds the demand for US duration."},{"src":"BRENT","dst":"RECESSION_RISK","sign":1,"weight":0.25,"lag_days":0,"confidence":0.35,"rationale":"A sustained crude spike is a tax on the consumer. This is the offsetting channel: the same oil move that lifts inflation expectations also raises recession risk, and those two push mortgage rates in opposite directions."},{"src":"INFL_EXPECT","dst":"UST_10Y","sign":1,"weight":0.7,"lag_days":0,"confidence":0.9,"rationale":"The 10Y is a real yield plus an inflation expectation. Expectations move the nominal."},{"src":"CORE_CPI","dst":"FED_STANCE","sign":1,"weight":0.9,"lag_days":0,"confidence":0.9,"rationale":"Inflation is the Fed reaction function."},{"src":"AHE","dst":"FED_STANCE","sign":1,"weight":0.4,"lag_days":0,"confidence":0.6,"rationale":"Wage pressure hardens the Fed."},{"src":"UNRATE","dst":"FED_STANCE","sign":-1,"weight":0.7,"lag_days":0,"confidence":0.9,"rationale":"The employment half of the dual mandate."},{"src":"NFP","dst":"FED_STANCE","sign":1,"weight":0.6,"lag_days":0,"confidence":0.9,"rationale":"Strong hiring removes the case for easing."},{"src":"FED_STANCE","dst":"UST_2Y","sign":1,"weight":0.85,"lag_days":0,"confidence":0.9,"rationale":"The front end prices the expected path of policy."},{"src":"FED_STANCE","dst":"QT_RUNOFF","sign":1,"weight":0.5,"lag_days":0,"confidence":0.6,"rationale":"A hawkish Fed keeps runoff going."},{"src":"UST_2Y","dst":"UST_10Y","sign":1,"weight":0.5,"lag_days":0,"confidence":0.6,"rationale":"Front-end repricing pulls the belly and the long end, but only partly."},{"src":"NFP","dst":"GROWTH","sign":1,"weight":0.7,"lag_days":0,"confidence":0.9,"rationale":"Payrolls are the highest-frequency growth read."},{"src":"RETAIL","dst":"GROWTH","sign":1,"weight":0.5,"lag_days":0,"confidence":0.6,"rationale":""},{"src":"GROWTH","dst":"UST_10Y","sign":1,"weight":0.6,"lag_days":0,"confidence":0.9,"rationale":"Stronger growth lifts real yields."},{"src":"NFP","dst":"RECESSION_RISK","sign":-1,"weight":0.7,"lag_days":0,"confidence":0.9,"rationale":""},{"src":"UNRATE","dst":"RECESSION_RISK","sign":1,"weight":0.7,"lag_days":0,"confidence":0.9,"rationale":""},{"src":"CLAIMS","dst":"RECESSION_RISK","sign":1,"weight":0.55,"lag_days":0,"confidence":0.6,"rationale":""},{"src":"JOLTS","dst":"RECESSION_RISK","sign":-1,"weight":0.4,"lag_days":0,"confidence":0.6,"rationale":""},{"src":"RECESSION_RISK","dst":"UST_10Y","sign":-1,"weight":0.75,"lag_days":0,"confidence":0.9,"rationale":"Recession fear is the classic bid for duration. Yields fall."},{"src":"TSY_SUPPLY","dst":"TERM_PREMIUM","sign":1,"weight":0.55,"lag_days":0,"confidence":0.6,"rationale":"More issuance demands more premium."},{"src":"FOREIGN_DEMAND","dst":"TERM_PREMIUM","sign":-1,"weight":0.55,"lag_days":0,"confidence":0.6,"rationale":""},{"src":"TERM_PREMIUM","dst":"UST_10Y","sign":1,"weight":0.8,"lag_days":0,"confidence":0.9,"rationale":""},{"src":"RISK_APPETITE","dst":"UST_10Y","sign":1,"weight":0.4,"lag_days":0,"confidence":0.6,"rationale":"Risk-on rotates out of Treasuries. Risk-off rotates in."},{"src":"DXY","dst":"FOREIGN_DEMAND","sign":1,"weight":0.3,"lag_days":0,"confidence":0.35,"rationale":""},{"src":"UST_10Y","dst":"MBS_YIELD","sign":1,"weight":0.9,"lag_days":0,"confidence":0.9,"rationale":"MBS are priced off the Treasury curve. This is the main channel."},{"src":"MOVE_VOL","dst":"MBS_SPREAD","sign":1,"weight":0.8,"lag_days":0,"confidence":0.9,"rationale":"MBS are short an embedded prepayment option. Rate volatility makes that option more expensive, so investors demand more spread."},{"src":"VIX","dst":"MBS_SPREAD","sign":1,"weight":0.35,"lag_days":0,"confidence":0.35,"rationale":""},{"src":"HY_SPREAD","dst":"MBS_SPREAD","sign":1,"weight":0.5,"lag_days":0,"confidence":0.6,"rationale":"General credit stress widens all spreads."},{"src":"QT_RUNOFF","dst":"MBS_SPREAD","sign":1,"weight":0.6,"lag_days":0,"confidence":0.6,"rationale":"Fed MBS runoff removes the largest price-insensitive buyer from the market."},{"src":"RISK_APPETITE","dst":"HY_SPREAD","sign":-1,"weight":0.7,"lag_days":0,"confidence":0.9,"rationale":""},{"src":"MBS_PRICE","dst":"MBS_YIELD","sign":-1,"weight":1.0,"lag_days":0,"confidence":0.9,"rationale":